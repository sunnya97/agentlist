  "claims": [
    {
      "field": "uniqueFeatures",
      "value": "Memory is MemFS, a git-backed filesystem of Markdown files the agent and the user can both inspect and edit, with every change committed",
      "status": "documented",
      "sourceIds": [
        "letta-memfs",
        "letta-memory"
      ],
      "shortValue": "Git-backed memory filesystem"
    },
    {
      "field": "computerUse",
      "value": "A computer in Letta is an execution environment with a shell and filesystem, on the current machine, a cloud sandbox, or a machine you bring; it is not graphical desktop control",
      "status": "limited",
      "sourceIds": [
        "letta-computers"
      ],
      "shortValue": "Shell and files, not a GUI"
    },
    {
      "field": "browserUse",
      "value": "A built-in browser-use skill appears in the changelog, but there is no dedicated documentation page for it; web search and page fetching are documented for cloud agents",
      "status": "limited",
      "sourceIds": [
        "letta-faq"
      ],
      "shortValue": "Browser skill, lightly documented"
    },
    {
      "field": "voice",
      "value": "A voice interface is not described",
      "status": "unknown",
      "sourceIds": []
    },
    {
      "field": "scheduling",
      "value": "Schedules run one-off or recurring prompts on cron, server-side on Cloud and only while a session is open locally; sleep-time subagents review recent conversations and consolidate memory in the background",
      "status": "documented",
      "sourceIds": [
        "letta-schedules",
        "letta-memory"
      ],
      "shortValue": "Cron schedules and sleep-time agents"
    },
    {
      "field": "desktopApps",
      "value": "No native desktop app; Letta Desktop is the web app installed as a progressive web app, and the former Electron app was retired in October 2026",
      "status": "documented",
      "sourceIds": [
        "letta-desktop"
      ],
      "shortValue": "PWA, not a native app"
    },
    {
      "field": "mobileApps",
      "value": "No official iOS or Android app; the documentation recommends the mobile web app",
      "status": "documented",
      "sourceIds": [
        "letta-faq"
      ],
      "shortValue": "None; mobile web"
    },
    {
      "field": "channels",
      "value": "Web app, desktop PWA and a command-line interface, plus messaging channels on the local backend",
      "status": "documented",
      "sourceIds": [
        "letta-desktop",
        "letta-channels"
      ],
      "shortValue": "Web, PWA and CLI"
    },
    {
      "field": "models",
      "value": "Model-agnostic across roughly 35 providers including Anthropic, OpenAI, Gemini, Bedrock, Mistral, DeepSeek and Groq, with local inference through Ollama, LM Studio and llama.cpp; the model can be changed mid-conversation",
      "status": "documented",
      "sourceIds": [
        "letta-models"
      ],
      "shortValue": "~35 providers; local inference"
    },
    {
      "field": "byom",
      "value": "Bring your own API keys on every plan, including the free tier",
      "status": "documented",
      "sourceIds": [
        "letta-pricing",
        "letta-models"
      ],
      "shortValue": "BYOK on all plans"
    },
    {
      "field": "bundledPlan",
      "value": "Open-source harness, optionally with a Letta Cloud subscription",
      "status": "documented",
      "sourceIds": [
        "letta-pricing"
      ]
    },
    {
      "field": "pricing",
      "value": "Free software. Letta Cloud is free for three agents, Pro US$20/month, an API plan at US$20/month plus usage, Teams Pro US$20/seat/month and custom Enterprise pricing",
      "status": "documented",
      "sourceIds": [
        "letta-pricing"
      ],
      "shortValue": "Free; Cloud from US$20/mo"
    },
    {
      "field": "license",
      "value": "Apache-2.0",
      "status": "documented",
      "sourceIds": [
        "letta-repo"
      ],
      "shortValue": "Apache-2.0"
    },
    {
      "field": "hosting",
      "value": "Self-hosted locally or by Docker, or hosted on Letta Cloud; run locally, all agent state stays on the device and no account is required",
      "status": "documented",
      "sourceIds": [
        "letta-selfhost"
      ],
      "shortValue": "Self-hosted or Letta Cloud"
    },
    {
      "field": "api",
      "value": "Public REST API at api.letta.com for Cloud agents, a TypeScript agent SDK, generated client SDKs, and a hosted MCP server",
      "status": "documented",
      "sourceIds": [
        "letta-api",
        "letta-faq"
      ],
      "shortValue": "REST API and SDKs"
    },
    {
      "field": "memory",
      "value": "A context repository of Markdown files holding persona, facts about the user, project facts, workflow rules and agent skills; files at the root load every turn and subdirectories load on demand",
      "status": "documented",
      "sourceIds": [
        "letta-memfs",
        "letta-memory"
      ],
      "shortValue": "Editable context repository"
    },
    {
      "field": "portability",
      "value": "Memory is a real git repository with full version history; local agents commit on the user's own machine and cloud agents can sync to GitHub",
      "status": "documented",
      "sourceIds": [
        "letta-memfs"
      ],
      "shortValue": "Git history; syncs to GitHub"
    },
    {
      "field": "security",
      "value": "Run locally, agent state including messages, memory and provider connections stays on the device; Enterprise adds role-based access control and SSO",
      "status": "documented",
      "sourceIds": [
        "letta-selfhost",
        "letta-pricing"
      ],
      "shortValue": "Local state; SSO on Enterprise"
    },
    {
      "field": "availability",
      "value": "Open source and installable from npm; Letta Cloud has open sign-up with a free tier",
      "status": "documented",
      "sourceIds": [
        "letta-selfhost",
        "letta-pricing"
      ],
      "shortValue": "Open source; free Cloud tier"
    }
  ],
