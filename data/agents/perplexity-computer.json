  "claims": [
    {
      "field": "uniqueFeatures",
      "value": "Brain builds a wiki-style memory of concepts, entities and workstreams from your sessions, connectors and files, which you can read, edit and correct",
      "status": "documented",
      "sourceIds": [
        "pc-brain"
      ],
      "shortValue": "Editable wiki-style memory"
    },
    {
      "field": "computerUse",
      "value": "Cloud tasks get a real filesystem and browser on Perplexity's isolated machine; the separate Personal Computer desktop app controls the user's own machine including native apps like Mail and Finder",
      "status": "documented",
      "sourceIds": [
        "pc-blog",
        "pc-personal"
      ],
      "shortValue": "Its cloud machine, and yours"
    },
    {
      "field": "browserUse",
      "value": "A real browser in its isolated cloud environment",
      "status": "documented",
      "sourceIds": [
        "pc-blog"
      ],
      "shortValue": "Yes, on its own machine"
    },
    {
      "field": "voice",
      "value": "Voice control is listed as part of the Personal Computer desktop app",
      "status": "documented",
      "sourceIds": [
        "pc-personal"
      ],
      "shortValue": "Voice in the desktop app"
    },
    {
      "field": "scheduling",
      "value": "Scheduled Tasks run hourly, daily, weekly, monthly or on a custom cadence, at most once an hour and up to fifteen active per conversation, managed in an automations dashboard",
      "status": "documented",
      "sourceIds": [
        "pc-tasks"
      ],
      "shortValue": "Scheduled tasks, hourly minimum"
    },
    {
      "field": "desktopApps",
      "value": "Desktop apps for macOS 15 and later, Windows 10 and 11, and Ubuntu",
      "status": "documented",
      "sourceIds": [
        "pc-personal"
      ],
      "shortValue": "macOS, Windows, Linux"
    },
    {
      "field": "mobileApps",
      "value": "Native iOS and Android apps",
      "status": "documented",
      "sourceIds": [
        "pc-help"
      ],
      "shortValue": "iOS, Android"
    },
    {
      "field": "channels",
      "value": "Web, iOS, Android and desktop apps, plus Slack and email",
      "status": "documented",
      "sourceIds": [
        "pc-help",
        "pc-slack",
        "pc-email"
      ],
      "shortValue": "Apps, Slack and email"
    },
    {
      "field": "models",
      "value": "Multi-provider, using Claude for core reasoning at launch alongside Gemini, Grok and ChatGPT as sub-agents; Portable Computer runs local models on your own hardware",
      "status": "documented",
      "sourceIds": [
        "pc-blog",
        "pc-portable"
      ],
      "shortValue": "Multi-provider; local on Portable"
    },
    {
      "field": "byom",
      "value": "Custom API credentials are for third-party services the agent calls, not for model providers",
      "status": "limited",
      "sourceIds": [
        "pc-help"
      ],
      "shortValue": "Service keys, not model keys"
    },
    {
      "field": "bundledPlan",
      "value": "Included with a paid Perplexity subscription",
      "status": "documented",
      "sourceIds": [
        "pc-plans"
      ],
      "shortValue": "With a Perplexity plan"
    },
    {
      "field": "pricing",
      "value": "Requires a paid plan: Pro US$20/month or US$200/year, Max US$200/month or US$2,000/year including 10,000 Computer credits a month; Pro includes no Computer credits. Enterprise Pro starts at US$40/month per seat",
      "status": "documented",
      "sourceIds": [
        "pc-plans",
        "pc-max"
      ],
      "shortValue": "Pro US$20/mo; Max US$200/mo"
    },
    {
      "field": "hosting",
      "value": "A secure isolated environment in Perplexity's cloud by default; Portable Computer runs the model and agent on your own hardware, and Personal Computer runs on your desktop",
      "status": "documented",
      "sourceIds": [
        "pc-help",
        "pc-portable",
        "pc-personal"
      ],
      "shortValue": "Provider cloud, or your hardware"
    },
    {
      "field": "api",
      "value": "A developer API platform exists, but a public API for controlling the Computer agent is not described",
      "status": "limited",
      "sourceIds": [
        "pc-help"
      ],
      "shortValue": "No agent API described"
    },
    {
      "field": "memory",
      "value": "Brain stores concepts, entities and workstreams drawn from sessions, connectors, files and your corrections, excluding incognito sessions",
      "status": "documented",
      "sourceIds": [
        "pc-brain"
      ],
      "shortValue": "Brain, built from your work"
    },
    {
      "field": "portability",
      "value": "A self-serve export from the account details page",
      "status": "documented",
      "sourceIds": [
        "pc-gdpr"
      ],
      "shortValue": "Self-serve export"
    },
    {
      "field": "security",
      "value": "Cloud tasks run in a secure isolated environment, and incognito sessions are excluded from memory",
      "status": "documented",
      "sourceIds": [
        "pc-help",
        "pc-brain"
      ],
      "shortValue": "Isolated cloud; incognito excluded"
    },
    {
      "field": "availability",
      "value": "Available to subscribers on web, iOS and Android; Brain remains a research preview limited to Max and Enterprise Max subscribers",
      "status": "documented",
      "sourceIds": [
        "pc-help",
        "pc-brain"
      ],
      "shortValue": "Paid plans; Brain preview"
    }
