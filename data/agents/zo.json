  "claims": [
    {
      "field": "uniqueFeatures",
      "value": "An always-on cloud computer of your own with a 100 GB filesystem that keeps running with your laptop closed, and can host sites and services on custom domains",
      "status": "documented",
      "sourceIds": [
        "zo-home",
        "zo-automations",
        "zo-pricing"
      ],
      "shortValue": "Your own always-on computer"
    },
    {
      "field": "computerUse",
      "value": "Runs its own Chromium on your Zo workspace; the desktop app's Devices feature can additionally drive your physical computer, with separate opt-in for browser, shell and file access",
      "status": "documented",
      "sourceIds": [
        "zo-browser",
        "zo-devices"
      ],
      "shortValue": "Its machine, and optionally yours"
    },
    {
      "field": "browserUse",
      "value": "Its own Chromium streamed into a browser tab, where you sign in once and it can then act on those sites as you",
      "status": "documented",
      "sourceIds": [
        "zo-browser"
      ],
      "shortValue": "Its own Chromium, signed in"
    },
    {
      "field": "voice",
      "value": "A voice interface is not described",
      "status": "unknown",
      "sourceIds": []
    },
    {
      "field": "scheduling",
      "value": "Automations are described as a skill with a clock, triggered by events such as incoming email or file changes, by daily, weekly, monthly or custom schedules, or manually, and run even while your laptop is closed",
      "status": "documented",
      "sourceIds": [
        "zo-automations"
      ],
      "shortValue": "Event and schedule automations"
    },
    {
      "field": "desktopApps",
      "value": "Desktop apps for macOS, Windows and Linux with file sync",
      "status": "documented",
      "sourceIds": [
        "zo-desktop"
      ],
      "shortValue": "macOS, Windows, Linux"
    },
    {
      "field": "mobileApps",
      "value": "Mobile access is through the web; no native mobile app is described",
      "status": "limited",
      "sourceIds": [
        "zo-home"
      ],
      "shortValue": "Mobile web only"
    },
    {
      "field": "channels",
      "value": "Web interface and desktop apps, plus messaging channels and a personal email address",
      "status": "documented",
      "sourceIds": [
        "zo-home",
        "zo-messaging"
      ],
      "shortValue": "Web, desktop and chat"
    },
    {
      "field": "models",
      "value": "Anthropic, OpenAI, Google, xAI, DeepSeek, Moonshot, Z.ai, ByteDance, MiniMax and AssemblyAI; every model is unlocked on paid tiers",
      "status": "documented",
      "sourceIds": [
        "zo-models",
        "zo-pricing"
      ],
      "shortValue": "Ten providers"
    },
    {
      "field": "byom",
      "value": "Connect your own keys from OpenAI-compatible, Anthropic-compatible or Groq endpoints, and sign in to Codex and Gemini subscriptions",
      "status": "documented",
      "sourceIds": [
        "zo-byok"
      ],
      "shortValue": "BYOK and subscription sign-in"
    },
    {
      "field": "bundledPlan",
      "value": "Standalone Zo subscription",
      "status": "documented",
      "sourceIds": [
        "zo-pricing"
      ]
    },
    {
      "field": "pricing",
      "value": "Free fourteen-day trial, then Basic US$18/month with US$10 of AI credits, Pro US$64/month with US$40, and Ultra US$200/month with US$100. Every tier has a 100 GB disk",
      "status": "documented",
      "sourceIds": [
        "zo-pricing"
      ],
      "shortValue": "US$18–200/mo after trial"
    },
    {
      "field": "hosting",
      "value": "Primarily an always-on computer in Zo's cloud; the desktop app can also connect your own machine",
      "status": "documented",
      "sourceIds": [
        "zo-automations",
        "zo-devices"
      ],
      "shortValue": "Zo cloud, plus your machine"
    },
    {
      "field": "api",
      "value": "A public API with a token from advanced settings",
      "status": "documented",
      "sourceIds": [
        "zo-api"
      ],
      "shortValue": "Public API"
    },
    {
      "field": "memory",
      "value": "A persistent 100 GB filesystem with chat history, personas and rules; improved memory that remembers your work across sessions is a paid-tier feature, and files are directly browsable and editable",
      "status": "documented",
      "sourceIds": [
        "zo-pricing",
        "zo-home"
      ],
      "shortValue": "Persistent filesystem; paid recall"
    },
    {
      "field": "portability",
      "value": "A right to receive your data in a portable format by contacting the company, and ZIP archives from support after a trial ends; files themselves are directly downloadable",
      "status": "limited",
      "sourceIds": [
        "zo-privacy",
        "zo-pricing"
      ],
      "shortValue": "On request; files downloadable"
    },
    {
      "field": "security",
      "value": "The Devices feature requires separate opt-in for browser, shell and file access on your physical computer",
      "status": "documented",
      "sourceIds": [
        "zo-devices"
      ],
      "shortValue": "Per-capability opt-in"
    },
    {
      "field": "availability",
      "value": "Open self-serve sign-up with a fourteen-day trial and no credit card required; after the trial, ordinary computer access ends without a subscription",
      "status": "documented",
      "sourceIds": [
        "zo-pricing"
      ],
      "shortValue": "Public sign-up; 14-day trial"
    }
