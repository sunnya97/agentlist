  "claims": [
    {
      "field": "uniqueFeatures",
      "value": "Drives your real Chrome and desktop apps while asking before anything it cannot undo, and is built to run many agents cheaply on modest hardware",
      "status": "documented",
      "sourceIds": [
        "oh-browser",
        "oh-repo"
      ],
      "shortValue": "Drives your real browser and apps"
    },
    {
      "field": "computerUse",
      "value": "Operates the user's own desktop applications, choosing targets from on-screen controls without screenshots, and stopping before any payment",
      "status": "documented",
      "sourceIds": [
        "oh-browser"
      ],
      "shortValue": "Your desktop, with guardrails"
    },
    {
      "field": "browserUse",
      "value": "Drives a real Chrome browser on the user's machine",
      "status": "documented",
      "sourceIds": [
        "oh-browser"
      ],
      "shortValue": "Your real Chrome"
    },
    {
