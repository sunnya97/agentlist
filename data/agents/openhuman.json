      "sourceIds": [
        "oh-models"
      ],
      "shortValue": "26 providers; local models"
    },
    {
      "field": "byom",
      "value": "Bring your own keys, or run local models; the optional hosted tiers buy cheaper inference rather than features",
      "status": "documented",
      "sourceIds": [
        "oh-models",
        "oh-billing"
      ],
      "shortValue": "BYOK or local"
    },
    {
      "field": "bundledPlan",
      "value": "Free open-source app, with optional paid hosted inference",
      "status": "documented",
      "sourceIds": [
        "oh-billing"
      ]
    },
    {
      "field": "pricing",
      "value": "The app is free. Optional hosted inference is Basic US$19.99/month or US$199/year and Pro US$199.99/month or US$1,799.99/year; every tier has every feature and higher tiers only buy cheaper inference",
      "status": "documented",
      "sourceIds": [
        "oh-billing"
      ],
      "shortValue": "Free app; optional inference tiers"
    },
    {
      "field": "license",
      "value": "GPL-3.0",
      "status": "documented",
      "sourceIds": [
        "oh-license"
      ],
      "shortValue": "GPL-3.0"
    },
    {
      "field": "hosting",
      "value": "Runs on the user's own Mac, Windows or Linux desktop, and can run headless on a Linux server; an optional hosted backend provides inference and billing",
      "status": "documented",
      "sourceIds": [
        "oh-repo",
        "oh-home"
      ],
      "shortValue": "Your desktop or your server"
    },
    {
      "field": "api",
      "value": "A JSON-RPC core over loopback or remote with a bearer token, a typed Rust embedding API, and an opt-in MCP server",
      "status": "documented",
      "sourceIds": [
        "oh-repo"
      ],
      "shortValue": "JSON-RPC, Rust API and MCP"
    },
    {
      "field": "approvals",
      "value": "Asks before anything it cannot undo and stops before any payment",
      "status": "documented",
      "sourceIds": [
        "oh-browser"
      ],
      "shortValue": "Asks before irreversible steps"
    },
    {
      "field": "memory",
      "value": "Remembers what you are working on, what you prefer and what is in your documents; the interface lets you add, delete, forget an item or forget a whole source",
      "status": "documented",
      "sourceIds": [
        "oh-memory"
      ],
      "shortValue": "Editable, with forget"
    },
    {
      "field": "portability",
      "value": "No export feature is described; moving to another computer is a manual copy of the local data folder",
      "status": "limited",
      "sourceIds": [
        "oh-move"
      ],
      "shortValue": "Manual folder copy"
    },
    {
      "field": "security",
      "value": "Sandboxing through an operating-system jail or Docker; memory can be stored on a self-hosted database instead of the vendor's",
      "status": "documented",
      "sourceIds": [
        "oh-repo",
        "oh-memory"
      ],
      "shortValue": "Jail or Docker sandbox"
    },
    {
