  "claims": [
    {
      "field": "uniqueFeatures",
      "value": "Memory is a personal knowledge base of structured Markdown files that are readable, editable, searchable and linked, alongside a MEMORY.md the user and agent both maintain",
      "status": "documented",
      "sourceIds": [
        "qp-memory"
      ],
      "shortValue": "Editable Markdown knowledge base"
    },
    {
      "field": "computerUse",
      "value": "An optional Computer Use plugin operates approved desktop applications on the user's own machine, limited to Windows 10 and later or macOS 14 and later in the desktop app, and marked beta",
      "status": "limited",
      "sourceIds": [
        "qp-repo"
      ],
      "shortValue": "Your desktop, beta, not Linux"
    },
    {
      "field": "browserUse",
      "value": "Launches its own Chromium, or drives the Chrome you are already signed in to through an extension",
      "status": "documented",
      "sourceIds": [
        "qp-repo"
      ],
      "shortValue": "Its Chromium or your Chrome"
    },
    {
      "field": "voice",
      "value": "Voice and SIP are listed among its channels",
      "status": "documented",
      "sourceIds": [
        "qp-channels"
      ],
      "shortValue": "Voice and SIP channels"
    },
    {
      "field": "scheduling",
      "value": "Heartbeat runs at an interval and replies in the channel where you last chatted, alongside cron scheduled tasks that can run several recurring jobs in parallel",
      "status": "documented",
      "sourceIds": [
        "qp-repo"
      ],
      "shortValue": "Heartbeat and cron"
    },
    {
      "field": "desktopApps",
      "value": "A Tauri desktop app for Windows 10 and later and macOS 14 and later, marked beta and unnotarised on macOS, plus a console web interface and a full terminal interface",
      "status": "limited",
      "sourceIds": [
        "qp-repo"
      ],
      "shortValue": "Windows and macOS, beta"
    },
    {
      "field": "mobileApps",
      "value": "No mobile app",
      "status": "documented",
      "sourceIds": [
        "qp-repo"
      ],
      "shortValue": "None"
    },
    {
      "field": "channels",
      "value": "Desktop app, console web interface and terminal, plus more than a dozen chat channels",
      "status": "documented",
      "sourceIds": [
        "qp-repo",
        "qp-channels"
      ],
      "shortValue": "Desktop, web, terminal and chat"
    },
    {
      "field": "models",
      "value": "Built-in local QwenPaw-Flash models from 2B to 35B through llama.cpp, Ollama and LM Studio, plus keys for more than fourteen cloud providers including Qwen, OpenAI, Anthropic, Gemini, DeepSeek and Kimi",
      "status": "documented",
      "sourceIds": [
        "qp-repo"
      ],
      "shortValue": "Local models; 14+ providers"
    },
    {
      "field": "byom",
      "value": "Bring your own keys, or run the bundled local models",
      "status": "documented",
      "sourceIds": [
        "qp-repo"
      ],
      "shortValue": "BYOK or local"
    },
    {
      "field": "bundledPlan",
      "value": "Open-source software; the AgentScope Platform offers free hosted deployment",
      "status": "documented",
      "sourceIds": [
        "qp-repo"
      ]
    },
    {
      "field": "pricing",
      "value": "Free software. A hosted deployment on the AgentScope Platform is offered free; a cloud model key is required unless you run local models",
      "status": "documented",
      "sourceIds": [
        "qp-repo"
      ],
      "shortValue": "Free; free hosted option"
    },
    {
      "field": "license",
      "value": "Apache-2.0",
