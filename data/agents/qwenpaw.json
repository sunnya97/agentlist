      "sourceIds": [
        "qp-license"
      ],
      "shortValue": "Apache-2.0"
    },
    {
      "field": "hosting",
      "value": "Self-hosted by pip, a script, Docker or the desktop app, or deployed to Alibaba Cloud, the AgentScope Platform or ModelScope",
      "status": "documented",
      "sourceIds": [
        "qp-repo"
      ],
      "shortValue": "Self-hosted or free cloud"
    },
    {
      "field": "api",
      "value": "A REST API built on the AgentScope Runtime protocol, with an agent identifier header, plus ACP integration",
      "status": "documented",
      "sourceIds": [
        "qp-repo"
      ],
      "shortValue": "REST API and ACP"
    },
    {
      "field": "memory",
      "value": "Three layers: a live working context, the full verbatim history, and a personal knowledge base of structured Markdown in a local workspace directory",
      "status": "documented",
      "sourceIds": [
        "qp-memory"
      ],
      "shortValue": "Three layers, Markdown on disk"
    },
    {
      "field": "portability",
      "value": "Settings include a backup tool that exports the whole agent environment as a zip containing workspaces, persona, memory, skills, chat history, settings and secrets",
      "status": "documented",
      "sourceIds": [
        "qp-repo"
      ],
      "shortValue": "Self-serve zip backup"
    },
    {
      "field": "security",
      "value": "Deploy locally and data stays on your machine; secrets are held in the agent environment",
      "status": "documented",
      "sourceIds": [
        "qp-repo"
      ],
      "shortValue": "Local deployment"
    },
    {
      "field": "availability",
      "value": "Open source; install by pip, script, Docker or the desktop app, with a free hosted option",
      "status": "documented",
      "sourceIds": [
        "qp-repo"
      ],
      "shortValue": "Open source; free hosting"
    }
